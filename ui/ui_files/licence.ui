  <property name="styleSheet">
   <string notr="true">#main_dialog{background-color: #4764c3;}
QLabel{
background-color: none;
color:#fcff5d;
font: 'Grenada';
font-size: 14px;
}
QLabel#lbl_text_1, #lbl_text_2{
background-color: none;
color:#fcff5d;
font: 'Yu Gothic UI';
font-size: 12px;}
QPushButton {background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0.2 #0ee1e5, stop: 0.6 #3aa7b3, stop: 0.6 #163682, stop: 0.8 #2a2f6f);
    color: #fff;
    font-family: 'DatonaPro'; font-size: 14px; font-weight: bold; text-align: center;
    border-radius: 8px; border-top: 1px solid #C0C0C0; border-left: 1px solid #C0C0C0; border-right: 2px solid #000; 
	border-bottom: 3px solid #000; 
    padding-left : 8px;
    margin-right: 4px;  margin-bottom: 5px;  
    min-width: 130px;
	min-height: 30px;}
QPushButton:hover {
color:#d9cc37;
}
QPushButton:pressed {
color:red;
padding-top: 5px;
}
QLineEdit{
border: none;
color:#ffaa00;
background-color: transparent;
font: 'Grenada';
font-size: 14px;
}
QLineEdit:focus{
color: black;
background-color:#fff89b;
border-radius: 4px solid #000;
}</string>
